<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServiceTierPath>$(HOME)/.local/share/al-runner/artifacts/27.5.46862.48827</ServiceTierPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="SpikeBuild"><HintPath>$(MSBuildProjectDirectory)/../bin/Debug/net8.0/SpikeBuild.dll</HintPath></Reference>
    <Reference Include="Microsoft.Dynamics.Nav.Types"><HintPath>$(ServiceTierPath)/Microsoft.Dynamics.Nav.Types.dll</HintPath></Reference>
    <Reference Include="Microsoft.Dynamics.Nav.Ncl"><HintPath>$(ServiceTierPath)/Microsoft.Dynamics.Nav.Ncl.dll</HintPath></Reference>
    <Reference Include="Microsoft.Dynamics.Nav.Common"><HintPath>$(ServiceTierPath)/Microsoft.Dynamics.Nav.Common.dll</HintPath></Reference>
    <Reference Include="Microsoft.Dynamics.Nav.Language"><HintPath>$(ServiceTierPath)/Microsoft.Dynamics.Nav.Language.dll</HintPath></Reference>
  </ItemGroup>
  <!-- After build: drop our WindowsPrincipalStub on top of the shared-framework BCL version.
       App-local resolution wins over shared framework, so BC's WindowsIdentity.GetCurrent()
       binds to our Linux-friendly stub instead of throwing PlatformNotSupportedException. -->
  <Target Name="OverlayStub" AfterTargets="Build">
    <Exec Command="dotnet build $(MSBuildProjectDirectory)/../shims/WindowsPrincipalStub/WindowsPrincipalStub.csproj -c $(Configuration) -v q" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../shims/WindowsPrincipalStub/bin/$(Configuration)/net8.0/System.Security.Principal.Windows.dll"
          DestinationFolder="$(OutDir)" OverwriteReadOnlyFiles="true" />
  </Target>
</Project>
